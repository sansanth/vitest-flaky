{
  "name": "vitest-flaky",
  "version": "0.3.0",
  "description": "Find flaky Vitest tests on your laptop: replays a slow CI runner by firing the app's timers early, resuming tests late and shuffling the order, with a seed that replays a failure.",
  "keywords": [
    "vitest",
    "flaky",
    "flaky-tests",
    "testing-library",
    "timers",
    "ci"
  ],
  "license": "MIT",
  "author": "Sandhu Santhakumar <code@sandhu.sh>",
  "homepage": "https://github.com/sansanth/vitest-flaky#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sansanth/vitest-flaky.git"
  },
  "bugs": "https://github.com/sansanth/vitest-flaky/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "vitest-flaky": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
